		sourceColumn: circuit_id

	column sector_id
		dataType: int64
		summarizeBy: none
		sourceColumn: sector_id

	column segment_order
		dataType: int64
		summarizeBy: none
		sourceColumn: segment_order

	column kind
		dataType: string
		summarizeBy: none
		sourceColumn: kind

	column length_m
		dataType: int64
		summarizeBy: none
		sourceColumn: length_m

	column radius_m
		dataType: int64
		summarizeBy: none
		sourceColumn: radius_m

	column banking_rad
		dataType: double
		summarizeBy: none
		sourceColumn: banking_rad

	column grade_rad
		dataType: int64
		summarizeBy: none
		sourceColumn: grade_rad

	column surface_grip
		dataType: int64
		summarizeBy: none
		sourceColumn: surface_grip

	column width_m
