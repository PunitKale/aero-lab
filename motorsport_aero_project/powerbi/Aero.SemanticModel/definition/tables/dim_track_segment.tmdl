	partition dim_track_segment = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "/dim_track_segment.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"segment_id", Int64.Type}, {"circuit_id", Int64.Type}, {"sector_id", Int64.Type}, {"segment_order", Int64.Type}, {"kind", type text}, {"length_m", Int64.Type}, {"radius_m", Int64.Type}, {"banking_rad", type number}, {"grade_rad", Int64.Type}, {"surface_grip", Int64.Type}, {"width_m", Int64.Type}, {"drs_zone", Int64.Type}, {"drs_start_fraction", type number}, {"drs_end_fraction", type number}, {"data_source_type", type text}, {"synthetic_flag", type logical}, {"model_version", type text}, {"data_version", type text}, {"generation_timestamp", type text}, {"random_seed", Int64.Type}, {"validation_status", type text}}, "en-US")
			in
				Typed